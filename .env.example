# RolePlayCard runtime configuration
#
# Copy this file to `.env` before changing local deployment settings.
# `.env` is intentionally ignored by git.

# Production/API server bind address and port.
HOST=127.0.0.1
PORT=8765

# Server-side persistent data and built frontend static files.
DATA_DIR=.role-play-card-data
STATIC_DIR=vue-renderer/dist

# Vite development server.
WEB_HOST=127.0.0.1
WEB_PORT=5173

# Optional explicit dev proxy target. Leave empty to use HOST/PORT.
# API_BASE_URL=http://127.0.0.1:8765
