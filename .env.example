# RolePlayCard runtime configuration
#
# Copy this file to `.env` before changing local deployment settings.
# `.env` is intentionally ignored by git.

# Public application bind address and port.
# Both development and PM2 production are opened from this address.
APP_HOST=127.0.0.1
APP_PORT=8765

# Development-only API bind address and port.
# npm run dev serves the UI on APP_PORT and proxies /api here.
API_HOST=127.0.0.1
API_PORT=8766

# Server-side persistent data and built frontend static files.
DATA_DIR=.role-play-card-data
STATIC_DIR=vue-renderer/dist

# Optional explicit dev proxy target. Leave empty to use API_HOST/API_PORT.
# API_BASE_URL=http://127.0.0.1:8766
